# =============================================================================
# Hetzner MCP Connection - Configuración de Entorno
# =============================================================================
# Copia este archivo a .env y configura tus credenciales

# -----------------------------------------------------------------------------
# Configuración de API de Hetzner Cloud
# -----------------------------------------------------------------------------
# Token de API (requerido)
# Genera tu token en: https://console.hetzner.cloud/security/api-tokens
HETZNER_API_TOKEN=tu_token_de_api_aqui

# URL de la API (opcional, por defecto: https://api.hetzner.cloud/v1)
HETZNER_API_URL=https://api.hetzner.cloud/v1

# -----------------------------------------------------------------------------
# Configuración de Conexión
# -----------------------------------------------------------------------------
# Timeout para requests en segundos (por defecto: 30)
REQUEST_TIMEOUT=30

# Número máximo de reintentos para requests fallidos (por defecto: 3)
MAX_RETRIES=3

# Retraso entre reintentos en segundos (por defecto: 1)
RETRY_DELAY=1

# -----------------------------------------------------------------------------
# Configuración de Logging
# -----------------------------------------------------------------------------
# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL (por defecto: INFO)
LOG_LEVEL=INFO

# Formato de logging: simple, detailed, json (por defecto: simple)
LOG_FORMAT=simple

# -----------------------------------------------------------------------------
# Configuración de Paginación
# -----------------------------------------------------------------------------
# Número de resultados por página (por defecto: 25, máximo: 50)
PAGE_SIZE=25

# -----------------------------------------------------------------------------
# Configuración de Automatización
# -----------------------------------------------------------------------------
# Directorio para almacenar backups locales (opcional)
BACKUP_DIR=./backups

# Prefijo para nombres de recursos creados automáticamente
AUTO_PREFIX=auto-

# -----------------------------------------------------------------------------
# Configuración de Seguridad
# -----------------------------------------------------------------------------
# Habilitar modo seguro (solo lectura, por defecto: False)
SAFE_MODE=false

# Lista de IDs de servidores protegidos (separados por coma)
PROTECTED_SERVERS=

# =============================================================================
# NOTA: Nunca compartas tu .env con el token de API en repositorios públicos
# =============================================================================
